# Bazowy adres backendu LoyaltyClub uzywany w buildzie produkcyjnym.
# Puste (lub brak zmiennej) = zadania ida na ten sam origin co SPA,
# co jest poprawne, gdy przed frontendem stoi reverse proxy kierujace /api na backend.
VITE_API_BASE_URL=

# Cel proxy serwera deweloperskiego Vite dla sciezek /api.
# Domyslnie http://localhost:8089 (lokalnie uruchomiony Spring Boot).
VITE_DEV_API_PROXY=http://localhost:8089
